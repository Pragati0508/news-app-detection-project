body {
  font-family: Arial, sans-serif;
  background: linear-gradient(to right, #6dd5fa, #2980b9);
  color: white;
  text-align: center;
  margin: 0;
  padding: 0;
}

.weather-container {
  margin-top: 100px;
}

input {
  padding: 10px;
  width: 200px;
  border: none;
  border-radius: 5px;
}

button {
  padding: 10px 20px;
  margin-left: 10px;
  border: none;
  border-radius: 5px;
  background-color: #27ae60;
  color: white;
  cursor: pointer;
}

button:hover {
  background-color: #2ecc71;
}

#result {
  margin-top: 20px;
  font-size: 1.5em;
}
